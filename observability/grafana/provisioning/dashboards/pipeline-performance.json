{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "uid": "proxim-pipeline-performance",
  "title": "Proxim — Pipeline Performance",
  "tags": ["proxim", "pipeline"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scoring Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ name = \"scoring\" } | quantile_over_time(duration, 0.95)",
          "legendFormat": "p95 scoring"
        }
      ]
    },
    {
      "id": 2,
      "title": "Resume Generation Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ name = \"resume_generation\" } | quantile_over_time(duration, 0.95)",
          "legendFormat": "p95 resume"
        }
      ]
    },
    {
      "id": 3,
      "title": "Score Jobs per Run",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ name = \"score_job\" } | count_over_time()",
          "legendFormat": "score_job spans"
        }
      ]
    }
  ]
}
