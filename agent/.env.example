DATABASE_URL=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
POLLING_INTERVAL_SECONDS=3
AGENT_PORT=8001
# Hunter.io email discovery (F6)
HUNTER_API_KEY=
# Gmail OAuth2 (F6) — from Google Cloud Console OAuth client JSON
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Tracking pixel host (F6) — set to your public domain in production
TRACKING_HOST=http://localhost:3000
# Langfuse LLM cost tracking — uses REST ingestion API (no langfuse Python SDK needed)
# Get keys from cloud.langfuse.com  US: us.cloud.langfuse.com  EU: cloud.langfuse.com
# When set, every LiteLLM call is posted to <LANGFUSE_BASE_URL>/api/public/ingestion
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# OpenTelemetry (F8) — points to OTel Collector gRPC endpoint (Python agent)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=proxim-agent
# LangSmith dev tracing (F8) — Set true in dev/staging ONLY — never production
LANGSMITH_TRACING=false          # Set true in dev/staging ONLY — never production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=               # LangSmith API key
LANGSMITH_PROJECT="Proxim"       # LangSmith project name (read by LangGraph automatically)
ENVIRONMENT=development      # development | staging | production
