# Copy to `.env` (next to docker-compose.yml) and fill in. This single file is
# used both for docker-compose ${VAR} interpolation AND as the containers' env.
# NEVER commit the real .env.

# ── Public address (Caddy + email tracking + OAuth) ─────────────────────────
DOMAIN=proxim.example.com            # DNS A record must point at this VPS
ACME_EMAIL=you@example.com           # Let's Encrypt account / expiry notices

# ── Database (shared by BOTH runtimes — CLAUDE.md invariant) ─────────────────
# Option A (default, self-contained): SQLite file on the shared /data volume.
DATABASE_URL=/data/proxim.db
# Option B (managed Postgres): a Neon connection string. If you use this,
# rebuild the web image (the driver is chosen at build time):
#   DATABASE_URL=postgresql://USER:PASS@HOST/db?sslmode=require

# ── LLM provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic               # or: gemini
LLM_MODEL=claude-sonnet-4-6          # gemini default: gemini-2.5-flash
ANTHROPIC_API_KEY=                   # required if LLM_PROVIDER=anthropic
GEMINI_API_KEY=                      # required if LLM_PROVIDER=gemini

# ── External services ───────────────────────────────────────────────────────
EXA_API_KEY=                         # job discovery + contact/email web search
HUNTER_API_KEY=                      # hiring-manager email lookup/verification

# ── Outreach email (Gmail OAuth) ────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Tracking pixels/links in emails point here — MUST be your public https URL,
# not localhost. Keep it in sync with DOMAIN above.
TRACKING_HOST=https://proxim.example.com

# ── Optional telemetry (leave blank to disable) ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# NOTE: RESUME_OUTPUT_DIR is intentionally NOT set here — docker-compose.yml
# sets it per-service (/data/base-resumes for web, /data/output/resumes for the
# agent) because the two runtimes need different sub-paths of the shared volume.
